{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart: state rankings by drama production spend each year. Hover a line to highlight it.",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/spend_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "spend_m": "number",
        "year_start": "number",
        "capital_lat": "number",
        "capital_lon": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "spend_m",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "grid": false
      },
      "scale": {
        "padding": 0.6
      }
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "title": "Rank (1 = biggest spend)",
      "axis": {
        "grid": false
      }
    },
    "color": {
      "condition": {
        "param": "hover",
        "field": "state_name",
        "type": "nominal",
        "legend": null,
        "scale": {
          "domain": [
            "Queensland",
            "New South Wales",
            "Victoria",
            "South Australia",
            "Western Australia",
            "ACT, NT & Tasmania"
          ],
          "range": [
            "#C08420",
            "#cfcabb",
            "#9a968b",
            "#6f6c64",
            "#6f6c64",
            "#6f6c64"
          ]
        }
      },
      "value": "#3a3935"
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "empty": true,
        "value": 1
      },
      "value": 0.35
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "interpolate": "monotone"
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "stroke": "#1a1a19",
        "strokeWidth": 2,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "spend_m",
            "title": "Spend ($m)",
            "format": ",.0f"
          }
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "state_name"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.year == '2024/25'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "state_name"
        }
      }
    }
  ]
}