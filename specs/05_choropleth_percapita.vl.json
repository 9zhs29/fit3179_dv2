{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map: drama production spend per resident, 2024/25 (Screen Australia spend / ABS population)",
  "width": "container",
  "height": 380,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/percapita_2024_25.csv",
          "format": {
            "type": "csv",
            "parse": {
              "spend_m": "number",
              "population_000": "number",
              "spend_per_person": "number"
            }
          }
        },
        "key": "state_name",
        "fields": [
          "group",
          "spend_m",
          "population_000",
          "spend_per_person"
        ]
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#1a1a19",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "spend_per_person",
          "type": "quantitative",
          "title": "$ per resident",
          "scale": {
            "scheme": "goldorange",
            "domain": [
              0,
              170
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 180,
            "format": "$,.0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State"
          },
          {
            "field": "group",
            "title": "Reported as"
          },
          {
            "field": "spend_m",
            "title": "Production spend ($m)",
            "format": ",.0f"
          },
          {
            "field": "spend_per_person",
            "title": "Spend per resident ($)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.3,
            "lat": -22.0,
            "t": "Qld $161"
          },
          {
            "lon": 146.6,
            "lat": -32.4,
            "t": "NSW $96"
          },
          {
            "lon": 144.2,
            "lat": -37.0,
            "t": "Vic $102"
          },
          {
            "lon": 122.5,
            "lat": -26.0,
            "t": "WA $28"
          },
          {
            "lon": 135.5,
            "lat": -30.0,
            "t": "SA $49"
          },
          {
            "lon": 133.5,
            "lat": -20.0,
            "t": "NT* $15"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1a1a19"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}