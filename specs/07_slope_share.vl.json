{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart: each state's share of national drama spend, 2023/24 vs 2024/25",
  "width": 340,
  "height": 420,
  "data": {
    "url": "data/spend_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "spend_m": "number",
        "year_start": "number",
        "capital_lat": "number",
        "capital_lon": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year_start >= 2023"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "spend_m",
          "as": "total"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "calculate": "datum.spend_m / datum.total",
      "as": "share"
    },
    {
      "calculate": "{'NSW':'NSW','QLD':'QLD','VIC':'VIC','SA':'SA','WA':'WA','ACT/NT/TAS':'ACT, NT & Tas'}[datum.state] + ' ' + format(datum.share, '.0%')",
      "as": "label"
    },
    {
      "calculate": "datum.year_start == 2024 ? {'QLD':0.348,'NSW':0.31,'VIC':0.272,'SA':0.06,'WA':0.036,'ACT/NT/TAS':0.012}[datum.state] : {'NSW':0.471,'VIC':0.198,'QLD':0.172,'ACT/NT/TAS':0.075,'SA':0.051,'WA':0.027}[datum.state]",
      "as": "label_y"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false
      },
      "scale": {
        "padding": 0.25
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "title": null,
      "axis": null,
      "scale": {
        "domain": [
          0,
          0.5
        ]
      }
    },
    "detail": {
      "field": "state_name"
    },
    "color": {
      "condition": {
        "test": "datum.state == 'QLD'",
        "value": "#C08420"
      },
      "value": "#8a867c"
    },
    "opacity": {
      "condition": {
        "param": "sl",
        "empty": true,
        "value": 1
      },
      "value": 0.2
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90,
        "opacity": 1,
        "stroke": "#1a1a19",
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "year"
          },
          {
            "field": "share",
            "title": "Share",
            "format": ".0%"
          },
          {
            "field": "spend_m",
            "title": "Spend ($m)",
            "format": ",.0f"
          }
        ]
      },
      "params": [
        {
          "name": "sl",
          "select": {
            "type": "point",
            "fields": [
              "state_name"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.year_start == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "baseline": "middle"
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.state == 'QLD'",
            "value": "#e0b45c"
          },
          "value": "#d8d4c8"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_start == 2023"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 12,
        "baseline": "middle"
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.state == 'QLD'",
            "value": "#e0b45c"
          },
          "value": "#d8d4c8"
        }
      }
    }
  ]
}