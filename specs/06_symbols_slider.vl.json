{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: production spend in each mainland state, with a year slider. ACT, NT and Tasmania are reported combined by Screen Australia, so are not mapped.",
  "width": "container",
  "height": 470,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "yr",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2018,
        "max": 2024,
        "step": 1,
        "name": "Year production started: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#2a2925",
        "stroke": "#1a1a19",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/spend_by_state.csv",
        "format": {
          "type": "csv",
          "parse": {
            "spend_m": "number",
            "year_start": "number",
            "capital_lat": "number",
            "capital_lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year_start == yr"
        },
        {
          "calculate": "isValid(datum.capital_lat) ? datum.capital_lon : 117.5",
          "as": "plon"
        },
        {
          "calculate": "isValid(datum.capital_lat) ? datum.capital_lat : -41.5",
          "as": "plat"
        },
        {
          "calculate": "isValid(datum.capital_lat) ? 0 : 1",
          "as": "combined"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "plon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "plat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "fill": "#C08420",
            "fillOpacity": 0.75,
            "stroke": "#1a1a19",
            "strokeWidth": 2
          },
          "encoding": {
            "size": {
              "field": "spend_m",
              "type": "quantitative",
              "title": "Spend ($m)",
              "scale": {
                "domain": [
                  0,
                  1250
                ],
                "range": [
                  0,
                  5000
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "values": [
                  100,
                  500,
                  1000
                ],
                "format": ",.0f",
                "title": "Spend ($m)"
              }
            },
            "tooltip": [
              {
                "field": "state_name",
                "title": "State"
              },
              {
                "field": "year",
                "title": "Financial year"
              },
              {
                "field": "spend_m",
                "title": "Spend ($m)",
                "format": ",.0f"
              }
            ],
            "strokeDash": {
              "condition": {
                "test": "datum.combined == 1",
                "value": [
                  3,
                  3
                ]
              },
              "value": [
                1,
                0
              ]
            },
            "stroke": {
              "condition": {
                "test": "datum.combined == 1",
                "value": "#e0b45c"
              },
              "value": "#1a1a19"
            },
            "fillOpacity": {
              "condition": {
                "test": "datum.combined == 1",
                "value": 0.35
              },
              "value": 0.75
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": 0,
            "dy": -4,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#f2efe6",
            "baseline": "middle"
          },
          "encoding": {
            "text": {
              "field": "spend_m",
              "type": "quantitative",
              "format": "$,.0f"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.combined == 1"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 16,
            "fontSize": 11,
            "color": "#b9b4a6",
            "baseline": "middle"
          },
          "encoding": {
            "text": {
              "value": "ACT, NT & Tas combined*"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "x": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "x": {
          "expr": "width - 6"
        },
        "y": 8,
        "fontSize": 32,
        "font": "Bebas Neue, Impact, sans-serif",
        "color": "#e0b45c",
        "text": {
          "expr": "yr + '/' + (yr % 100 + 1)"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}