{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: drama production spend by state and year",
  "width": "container",
  "height": 240,
  "data": {
    "url": "data/spend_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "spend_m": "number",
        "year_start": "number",
        "capital_lat": "number",
        "capital_lon": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "state_name",
      "type": "nominal",
      "title": null,
      "sort": [
        "New South Wales",
        "Queensland",
        "Victoria",
        "South Australia",
        "Western Australia",
        "ACT, NT & Tasmania"
      ],
      "axis": {
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#1a1a19",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "color": {
          "field": "spend_m",
          "type": "quantitative",
          "title": "Spend ($m)",
          "scale": {
            "scheme": "goldorange",
            "domain": [
              0,
              1250
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Financial year"
          },
          {
            "field": "spend_m",
            "title": "Spend ($m)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "field": "spend_m",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "condition": {
            "test": "datum.spend_m > 600",
            "value": "#1a1a19"
          },
          "value": "#f2efe6"
        }
      }
    }
  ]
}