{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: every $100 of drama production spend in Australia, 2024/25",
  "width": 300,
  "height": 300,
  "data": {
    "values": [
      {
        "category": "Australian features",
        "squares": 14,
        "spend_m": 379
      },
      {
        "category": "Australian TV & streaming",
        "squares": 26,
        "spend_m": 688
      },
      {
        "category": "International productions",
        "squares": 60,
        "spend_m": 1623
      }
    ]
  },
  "transform": [
    {
      "window": [
        {
          "op": "sum",
          "field": "squares",
          "as": "cum"
        }
      ]
    },
    {
      "calculate": "datum.cum - datum.squares",
      "as": "start"
    },
    {
      "calculate": "sequence(datum.start, datum.cum)",
      "as": "idx"
    },
    {
      "flatten": [
        "idx"
      ]
    },
    {
      "calculate": "datum.idx % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.idx / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "square",
    "size": 520,
    "cornerRadius": 2,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "descending"
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Australian features",
          "Australian TV & streaming",
          "International productions"
        ],
        "range": [
          "#C08420",
          "#169C9A",
          "#E2586B"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "vertical"
      }
    },
    "tooltip": [
      {
        "field": "category",
        "title": "Type"
      },
      {
        "field": "spend_m",
        "title": "Spend ($m)",
        "format": ",.0f"
      },
      {
        "field": "squares",
        "title": "Out of every $100"
      }
    ],
    "opacity": {
      "condition": {
        "param": "hl",
        "empty": true,
        "value": 1
      },
      "value": 0.2
    }
  },
  "params": [
    {
      "name": "hl",
      "select": {
        "type": "point",
        "fields": [
          "category"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      },
      "bind": "legend"
    }
  ]
}